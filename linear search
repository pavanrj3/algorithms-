def linear_search(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1
numbers = [10, 23, 45, 70, 11, 15]
x = 70

idx = linear_search(numbers, x)
if idx != -1:
    print(f"Element {x} found at index {idx}")
else:
    print(f"Element {x} not found")
